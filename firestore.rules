rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read, update: if request.auth.uid == uid || isAdmin();
      allow create: if request.auth != null;
    }

    match /balances/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if (request.auth.uid == uid 
                        && request.resource.data.available == 0 
                        && request.resource.data.locked == 0 
                        && request.resource.data.total == 0)
                    || isAdmin();
      allow update: if (request.auth.uid == uid 
                        && request.resource.data.total == resource.data.total
                        && request.resource.data.locked >= 0
                        && request.resource.data.available >= 0)
                    || isAdmin();
    }

    match /transactions/{txId} {
      allow create: if request.auth != null 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && (request.resource.data.type == 'deposit' || request.resource.data.type == 'withdrawal')
                    && request.resource.data.amount > 0;
      allow read: if request.auth.uid == resource.data.userId;
      allow read, update: if isAdmin();
    }

    match /holdings/{uid}/assets/{symbol} {
      allow read, write: if request.auth.uid == uid || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /assets/{symbol} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /watchlists/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
